# Environment: development, test, or production.
APP_ENV=development

# Development-only value. Production requires a unique random value of at least 50 characters.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# DATABASE_NAME=/absolute/path/to/db.sqlite3

# Browser origins are comma-separated and must include their scheme and port.
# APP_ENV=production accepts HTTPS origins only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# Development values are intentionally local. APP_ENV=production rejects SSL redirect/secure
# cookies disabled or HSTS=0. Verify HTTPS first; never enable preload without organizational review.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_X_FRAME_OPTIONS=DENY

# Console logging: text is convenient locally; production defaults to JSON.
LOG_LEVEL=INFO
LOG_FORMAT=text

DOCUMENT_MAX_UPLOAD_SIZE=26214400
# Leave room for multipart fields and request metadata above the document limit.
DATA_UPLOAD_MAX_MEMORY_SIZE=28311552
FILE_UPLOAD_MAX_MEMORY_SIZE=26214400
DOCUMENT_MAX_TEXT_LENGTH=120000
# OOXML zip-bomb ve PDF kaynak tüketimi sınırları.
DOCUMENT_MAX_ARCHIVE_ENTRIES=2000
DOCUMENT_MAX_UNCOMPRESSED_SIZE=104857600
DOCUMENT_MAX_PDF_PAGES=500
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=220
RAG_TOP_K=6

# OCR_MODEL_DIR=/absolute/path/to/ocr_models
OCR_ALLOW_MODEL_DOWNLOAD=false
OCR_USE_GPU=false
OCR_MAX_IMAGES=50
OCR_MAX_PIXELS=20000000
OCR_PDF_DPI=200
OCR_PDF_MIN_TEXT_LENGTH=40

JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=15
JOB_STALE_TIMEOUT=7200

AI_PROVIDER=local
# Keep local/private by default. Remote AI sends prompts/documents/images outside this host;
# explicit opt-in is required and production remote URLs must use HTTPS.
AI_ALLOW_REMOTE_SERVICES=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=600
OLLAMA_PULL_TIMEOUT=3600
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=qwen2.5:14b
LOCAL_LLM_TIMEOUT=180
WHISPER_CONNECTION=local
WHISPER_MODEL=base
WHISPER_BASE_URL=http://127.0.0.1:8002
WHISPER_TIMEOUT=180

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production must use a delivery-capable backend such as SMTP; console/dummy/file/locmem fail fast.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
# Stale in-flight notification claims become unknown and require reconciliation.
TECHNICAL_NOTIFICATION_PENDING_TIMEOUT=300
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=UAV Center <noreply@uav-center.local>

# APP_ENV=production requires an HTTPS Jira URL.
JIRA_SERVER=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_USERNAME=
JIRA_PASSWORD=
JIRA_PERSONAL_ACCESS_TOKEN=
JIRA_VERIFY_SSL=true
JIRA_TIMEOUT=30
JIRA_MEETING_PROJECT_KEY=MOM

# DOORS_DXL_BRIDGE=/absolute/path/to/doors_connector_bridge.dxl
DOORS_TEMP_DIR=
DOORS_LOCK_TIMEOUT=60
